# انسخ الملف ده لـ .env جنبه واملأ القيم الحقيقية. في الإنتاج (Render أو غيره) دي بتتحدد كـ
# environment variables على السيرفس نفسه، مش ملف - راجع ../DEPLOYMENT.md
DATABASE_URL=postgresql://postgres:test123@localhost:5432/satamoni_neo
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
PORT=4100

# لازم PGSSL=true لو DATABASE_URL بيوصل لقاعدة بيانات مُدارة برّه الشبكة الداخلية بتاعتها (زي Render
# External Database URL) - مش لازم محليًا أو مع Render Internal Database URL
PGSSL=false

# لسكريبتات استيراد البيانات من الريبو القديم (satamoni-backend) بس - قراءة فقط، مش لازم للسيرفر نفسه يشتغل
LEGACY_DATABASE_URL=postgresql://postgres:test123@localhost:5432/satamoni_jest_test
