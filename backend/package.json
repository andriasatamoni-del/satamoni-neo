{
  "name": "satamoni-neo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Satamoni ERP rebuild - DDD modular monolith backend",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "ts-node src/migrations/run-migrations.ts",
    "migrate:down": "ts-node src/migrations/run-migrations.ts down",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "import:branches": "ts-node scripts/import-branches-from-legacy.ts",
    "import:users": "ts-node scripts/import-users-from-legacy.ts",
    "import:crm": "ts-node scripts/import-crm-from-legacy.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
